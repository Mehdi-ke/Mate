# Copy this file to .env and fill in real values.

# Anthropic API key — required for the existing AI prototype tools.
ANTHROPIC_API_KEY=your-key-here

# Flask session signing key — REQUIRED for sessions and authentication.
# Must be stable and random. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))
SECRET_KEY=change-me-to-a-random-value

# Optional. Leave unset locally to use instance/mate.db. Railway/production
# should provide a PostgreSQL URL.
# DATABASE_URL=postgresql://user:password@host:5432/mate

# development (default), testing, or production.
FLASK_CONFIG=development

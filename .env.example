# Copy this file to .env and fill in real values.

# Anthropic API key — required for the AI tools to work.
ANTHROPIC_API_KEY=your-key-here

# Flask session signing key — REQUIRED for the Construction AI Assistant's
# chat history (Flask sessions). Must be set to a stable, random value;
# if it changes between restarts, active sessions are invalidated.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-value
